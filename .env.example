# ============================================================
# キャバ帳 環境変数テンプレート
#   本番ビルド前に .env（または .env.production）へコピーして値を設定。
#   VITE_ 接頭辞の値はビルド成果物(JS)に埋め込まれ公開される点に注意。
# ============================================================

# --- Firebase Web アプリ構成（コンソール「プロジェクトの設定 > マイアプリ > SDK設定」から取得） ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=points-optimizer-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=points-optimizer-app
VITE_FIREBASE_STORAGE_BUCKET=points-optimizer-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- AI（返信案・特別連絡・黒服相談・相性診断） ---
# 優先度: VITE_AI_PROXY_URL > VITE_GROQ_API_KEY > ローカル簡易生成
#
# 無料運用（Firebase Hosting 静的配信・Cloud Functions 不要）: Groq を直接利用
#   https://console.groq.com/keys で無料APIキーを発行して設定。
#   ※クライアント直呼びのためキーはバンドルに露出（無料枠のため影響はレート制限の悪用程度）。
VITE_GROQ_API_KEY=
# 省略時は llama-3.3-70b-versatile を使用
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# キーを秘匿したい場合のみ: サーバ経由プロキシのURL（設定時はこちらが優先され Groq 直呼びは無効）
# VITE_AI_PROXY_URL=
