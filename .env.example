# ============================================================
# キャバ帳 環境変数テンプレート(画面のビルド用)
#   VITE_ 接頭辞の値はビルド成果物(JS)に埋め込まれ公開される点に注意。秘密は書かない。
#   サーバー側の設定(Google ログインのクライアント ID / シークレットなど)は VPS の
#   /srv/apps/kyabacho/.env に置く(server/server.js の先頭コメント参照)。
# ============================================================

# --- 生成AIの機能(返信アシスト・特別連絡の文面・AI黒服「クロ」・占い/相性診断・予定のAI読み取り) ---
# 現在は蓋閉じ中。true にすると画面に表示し、下の設定で外部のAIサービスを使う。
VITE_ENABLE_AI=false

# AI を再開するときの接続先(OpenAI 互換 API)。優先度: VITE_AI_PROXY_URL > VITE_AI_API_KEY(直接) > 端末内の簡易生成
# ※直接呼び出しでは API キーがバンドルに露出する。従量課金 API は残高上限の設定を推奨。
#   例) Groq:     VITE_AI_API_KEY=gsk_xxx  VITE_AI_BASE_URL=https://api.groq.com/openai/v1  VITE_AI_MODEL=llama-3.3-70b-versatile
#   例) DeepSeek: VITE_AI_API_KEY=sk-xxx   VITE_AI_BASE_URL=https://api.deepseek.com        VITE_AI_MODEL=deepseek-chat
VITE_AI_API_KEY=
VITE_AI_BASE_URL=https://api.groq.com/openai/v1
VITE_AI_MODEL=llama-3.3-70b-versatile
