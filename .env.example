# Firebase Web SDK 設定（Firebase Console > プロジェクト設定 > マイアプリ から取得）
# 実値は .env に記載し、.env はコミットしないこと。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=points-optimizer-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=points-optimizer-app
VITE_FIREBASE_STORAGE_BUCKET=points-optimizer-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
