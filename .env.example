# ============================================================
# キャバ帳 環境変数テンプレート
#   本番ビルド前に .env（または .env.production）へコピーして値を設定。
#   VITE_ 接頭辞の値はビルド成果物(JS)に埋め込まれ公開される点に注意。
# ============================================================

# --- Firebase Web アプリ構成（コンソール「プロジェクトの設定 > マイアプリ > SDK設定」から取得） ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=points-optimizer-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=points-optimizer-app
VITE_FIREBASE_STORAGE_BUCKET=points-optimizer-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- AI（返信案・特別連絡・黒服相談・相性診断） ---
# 優先度: VITE_AI_PROXY_URL > VITE_AI_API_KEY(直接) > ローカル簡易生成
# OpenAI互換のチャットAPIならプロバイダ非依存で使える（BASE_URL と MODEL で切替）。
# ※直接呼び出しではAPIキーがバンドルに露出。従量課金APIは残高上限の設定を推奨。
#
# 例1) Groq（無料枠あり）: https://console.groq.com/keys で発行
#   VITE_AI_API_KEY=gsk_xxx
#   VITE_AI_BASE_URL=https://api.groq.com/openai/v1
#   VITE_AI_MODEL=llama-3.3-70b-versatile
# 例2) DeepSeek（従量課金）: https://platform.deepseek.com/api_keys で発行
#   VITE_AI_API_KEY=sk-xxx
#   VITE_AI_BASE_URL=https://api.deepseek.com
#   VITE_AI_MODEL=deepseek-chat
VITE_AI_API_KEY=
VITE_AI_BASE_URL=https://api.groq.com/openai/v1
VITE_AI_MODEL=llama-3.3-70b-versatile

# 後方互換: 旧 VITE_GROQ_API_KEY / VITE_GROQ_MODEL も解釈されます（新規は上の VITE_AI_* 推奨）

# キーを秘匿したい場合のみ: サーバ経由プロキシのURL（設定時はこちらが最優先／直接呼び出しは無効）
# VITE_AI_PROXY_URL=
